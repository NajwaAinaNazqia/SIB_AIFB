    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Ambil waktu sekarang (Jakarta)\nconst now = new Date(\n  new Date().toLocaleString(\"en-US\", { timeZone: \"Asia/Jakarta\" })\n);\n\nconst result = [];\n\nitems.forEach((item, index) => {\n  const row = item.json;\n\n  const dateStr = row['Scheduled Date']; // 11/02/2026\n  const timeStr = row['Scheduled Time']; // 9:30:00\n\n  const row_number = index + 2;\n\n  if (row.Status === 'Pending' && dateStr && timeStr) {\n\n    // SPLIT TANGGAL (dd/MM/yyyy)\n    const [day, month, year] = dateStr.split('/');\n\n    // NORMALISASI JAM\n    const fixedTime = timeStr.padStart(8, '0');\n\n    // GABUNG KE FORMAT ISO\n    const isoString = `${year}-${month}-${day}T${fixedTime}`;\n\n    const scheduledTime = new Date(isoString);\n\n    // Validasi\n    if (!isNaN(scheduledTime) && scheduledTime <= now) {\n      result.push({\n        json: {\n          ...row,\n          row_number\n        }\n      });\n    }\n  }\n});\n\nreturn result;"
      },
